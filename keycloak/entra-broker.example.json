{
  "_comment": "Merge into a Keycloak realm (identityProviders + identityProviderMappers) to let users sign in with Microsoft Entra ID. Entra App Registration redirect URI: https://<keycloak>/realms/<realm>/broker/entra/endpoint . Entra App Roles 'vdi-users' / 'vdi-admins' arrive in the 'roles' claim and are mapped to Keycloak groups, so the portal config does not change.",
  "identityProviders": [
    {
      "alias": "entra",
      "displayName": "Microsoft",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "syncMode": "FORCE",
      "config": {
        "issuer": "https://login.microsoftonline.com/<TENANT_ID>/v2.0",
        "authorizationUrl": "https://login.microsoftonline.com/<TENANT_ID>/oauth2/v2.0/authorize",
        "tokenUrl": "https://login.microsoftonline.com/<TENANT_ID>/oauth2/v2.0/token",
        "jwksUrl": "https://login.microsoftonline.com/<TENANT_ID>/discovery/v2.0/keys",
        "logoutUrl": "https://login.microsoftonline.com/<TENANT_ID>/oauth2/v2.0/logout",
        "clientId": "<ENTRA_CLIENT_ID>",
        "clientSecret": "${vault.entra-client-secret}",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid profile email",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256"
      }
    }
  ],
  "identityProviderMappers": [
    {"name": "username", "identityProviderAlias": "entra", "identityProviderMapper": "oidc-username-idp-mapper",
     "config": {"syncMode": "FORCE", "template": "${CLAIM.preferred_username}"}},
    {"name": "role vdi-users", "identityProviderAlias": "entra", "identityProviderMapper": "oidc-advanced-group-idp-mapper",
     "config": {"syncMode": "FORCE", "claims": "[{\"key\":\"roles\",\"value\":\"vdi-users\"}]", "group": "/vdi-users"}},
    {"name": "role vdi-admins", "identityProviderAlias": "entra", "identityProviderMapper": "oidc-advanced-group-idp-mapper",
     "config": {"syncMode": "FORCE", "claims": "[{\"key\":\"roles\",\"value\":\"vdi-admins\"}]", "group": "/vdi-admins"}}
  ]
}
